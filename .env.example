# --- Discord ---
DISCORD_TOKEN=your_bot_token
DISCORD_CLIENT_ID=your_application_id
# Discord user ID whose widget gets updated.
# Enable Developer Mode in Discord settings, then right-click yourself > Copy ID.
DISCORD_USER_ID=your_discord_user_id

# Identity index used in the profile endpoint. Keep this fixed per user:
# changing it makes Discord reject the write as a different provider account.
PROVIDER_ISSUED_USER_ID=0

# --- Last.fm ---
# Create at https://www.last.fm/api/account/create
LASTFM_API_KEY=your_lastfm_api_key
LASTFM_USER=fanzirfan

# --- Widget content ---
WIDGET_TITLE=FanzIrfan

# Optional custom image. Leave empty to send no image at all, which lets the
# Dev Portal fallback render. Must be a public HTTPS URL Discord can fetch.
WIDGET_IMAGE_URL=